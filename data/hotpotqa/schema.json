  "entity_schemas": {
    "Person": {
      "description": "Individual people, including historical figures, celebrities, athletes, politicians",
      "properties": [
        "name",
        "nationality",
        "occupation",
        "birth_date",
        "death_date"
      ]
    },
    "Organization": {
      "description": "Companies, institutions, sports teams, bands, government bodies",
      "properties": [
        "name",
        "founded_date",
        "location",
        "type"
      ]
    },
    "Location": {
      "description": "Geographic locations including countries, cities, regions, landmarks",
      "properties": [
        "name",
        "country",
        "type",
        "population"
      ]
    },
    "Event": {
      "description": "Historical events, battles, competitions, awards ceremonies",
      "properties": [
        "name",
        "date",
        "location",
        "type"
      ]
    },
    "CreativeWork": {
      "description": "Books, movies, TV shows, albums, songs, artworks",
      "properties": [
        "title",
        "creator",
        "release_date",
        "genre",
        "type"
      ]
    },
    "Date": {
      "description": "Specific dates or time periods",
      "properties": [
        "value",
        "granularity"
      ]
    },
    "Concept": {
      "description": "Abstract concepts, fields of study, ideologies",
      "properties": [
        "name",
        "domain"
      ]
    }
  },
