{
  "entity_types": [
    "Person",
    "Organization",
    "Location",
    "Event",
    "CreativeWork",
    "Date",
    "Concept"
  ],
  "relation_types": [
    "BORN_IN",
    "MEMBER_OF",
    "LOCATED_IN",
    "CREATED_BY",
    "OCCURRED_ON",
    "PARTICIPATED_IN",
    "RELATED_TO"
