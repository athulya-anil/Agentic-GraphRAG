    "BORN_IN": {
      "description": "Person was born in location",
      "properties": []
    },
    "MEMBER_OF": {
      "description": "Person is/was a member of organization",
      "properties": []
    },
    "LOCATED_IN": {
      "description": "Entity is located in location",
      "properties": []
    },
    "CREATED_BY": {
      "description": "Creative work was created by person or organization",
      "properties": []
    },
    "OCCURRED_ON": {
      "description": "Event occurred on date",
      "properties": []
    },
    "PARTICIPATED_IN": {
      "description": "Entity participated in event",
      "properties": []
    },
    "RELATED_TO": {
      "description": "Generic relationship between entities",
      "properties": []
    }
  }
}